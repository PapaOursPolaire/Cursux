{"author":"blife","website":"https://custom-cursor.com","email":"blife450@gmail.com","pack":{"id":98,"name":"Cat","description":"All cats have their own personalities, some say that orange cats are the friendliest of them all. But we found one black cat with white spots for you that is so friendly and nice that you can use him as your mouse cursor.","image":"cursors-logo.png","image_thumbnail":null,"slug":null,"url":"https://custom-cursor.com/en/collection/animals/cat","collection":{"id":5,"name":"Animals","description":"Add a cute little animal cursor to play on the screen.","image":"https://cdn.custom-cursor.com/collections/5/coll_animals.png","url":"https://custom-cursor.com/en/collection/animals"},"cursors":{"normal":{"Help":"","AppStarting":"","Wait":"","Crosshair":"","IBeam":"","NWPen":"","No":"","SizeNS":"","SizeWE":"","SizeNWSE":"","SizeNESW":"","SizeAll":"","UpArrow":"","Arrow":"Normal/Arrow.cur","Hand":"Normal/Hand.cur"},"large":null,"extraLarge":null}}}