{"author":"blife","website":"https://custom-cursor.com","email":"blife450@gmail.com","pack":{"id":5726,"name":"Among Drip Meme","description":"Among Drip refers to a viral 3D render of three crewmates from the 2018 video game Among Us wearing Nike Jordan shoes. The slang word drip is used to describe expensive clothes that are considered impressive, similar to swag. Meme cursor with Among Drip.","image":"cursors-logo.png","url":"https://custom-cursor.com/en/collection/memes/5726","collection":{"id":109,"name":"Memes","description":"Oi so we've got some Memes for you to solve your problemos.","image":"https://cdn.custom-cursor.com/collections/109/cover-collection-meme1.png","url":"https://custom-cursor.com/en/collection/memes"},"cursors":{"normal":{"Help":"","AppStarting":"","Wait":"","Crosshair":"","IBeam":"","NWPen":"","No":"","SizeNS":"","SizeWE":"","SizeNWSE":"","SizeNESW":"","SizeAll":"","UpArrow":"","Arrow":"Normal/Arrow.cur","Hand":"Normal/Hand.cur"},"large":null,"extraLarge":null}}}